{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EXO-Robotics/premode-router/schemas/pcodex.plugin-manifest.v1.schema.json",
  "title": "Canonical pCodex plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "author", "homepage", "repository", "license", "keywords", "skills", "interface"],
  "properties": {
    "name": {"const": "pcodex"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "description": {"type": "string", "minLength": 1},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {"name": {"const": "EXO Robotics"}, "url": {"type": "string", "format": "uri"}}
    },
    "homepage": {"type": "string", "format": "uri"},
    "repository": {"type": "string", "format": "uri"},
    "license": {"const": "Proprietary"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "skills": {"const": "./skills/"},
    "mcpServers": {"const": "./.mcp.json"},
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "shortDescription", "longDescription", "developerName", "category", "capabilities", "websiteURL", "privacyPolicyURL", "termsOfServiceURL", "defaultPrompt"],
      "properties": {
        "displayName": {"const": "pCodex"},
        "shortDescription": {"type": "string", "minLength": 1},
        "longDescription": {"type": "string", "minLength": 1},
        "developerName": {"const": "EXO Robotics"},
        "category": {"const": "Developer Tools"},
        "capabilities": {"type": "array", "items": {"enum": ["Read", "Advisory"]}, "uniqueItems": true},
        "websiteURL": {"type": "string", "format": "uri"},
        "privacyPolicyURL": {"type": "string", "format": "uri"},
        "termsOfServiceURL": {"type": "string", "format": "uri"},
        "defaultPrompt": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "maxLength": 128}}
      }
    }
  }
}
