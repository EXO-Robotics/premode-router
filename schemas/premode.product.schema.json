{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "premode.product.schema.json",
  "title": "pCodex product manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "product_name", "release_target", "release_class", "status",
    "supported_runtime", "version_source", "production_package", "phase_boundary", "documentation_contract",
    "production_branch_policy", "public_commands", "advanced_commands", "research_surfaces",
    "production_ranking_authority", "canonical_packet_authority", "cross_process_contracts", "install_state_authority", "no_write_authority",
    "public_surface_inventory", "stateful_surface_inventory", "integration_status", "known_beta_debt"
  ],
  "properties": {
    "$schema": {"const": "./schemas/premode.product.schema.json"},
    "schema_version": {"const": "premode.product.v2"},
    "product_name": {"const": "pCodex"},
    "release_target": {"const": "0.3.0b1"},
    "release_class": {"const": "Codex-first private technical beta"},
    "status": {"type": "string", "minLength": 1},
    "supported_runtime": {"const": "Codex CLI terminal workflow"},
    "version_source": {"const": "src/premode/__init__.py::__version__ (pyproject and plugin versions derive from it)"},
    "production_package": {"const": "premode-router"},
    "phase_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["phase_a", "phase_b", "roadmap_authority", "phase_b_remains_required"],
      "properties": {
        "phase_a": {"type": "string", "minLength": 1},
        "phase_b": {"type": "string", "minLength": 1},
        "roadmap_authority": {"const": "docs/ROADMAP_TO_90.md"},
        "phase_b_remains_required": {"const": true}
      }
    },
    "documentation_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_docs", "current_product_version", "supported_codex_versions", "declared_legacy_product_versions", "required_journeys"],
      "properties": {
        "canonical_docs": {
          "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true,
          "items": {"enum": ["README.md", "docs/GETTING_STARTED.md", "docs/CODEX_INTEGRATION.md", "docs/OPENCLAW_INTEGRATION.md", "docs/TROUBLESHOOTING.md", "docs/PRIVACY_AND_SAFETY.md", "docs/KNOWN_LIMITATIONS.md", "docs/MIGRATION.md", "docs/ROLLBACK.md", "docs/UNINSTALL.md"]}
        },
        "current_product_version": {"const": "0.3.0b1"},
        "supported_codex_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "0.143.x"}},
        "declared_legacy_product_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "0.2.6.24"}},
        "required_journeys": {
          "type": "object", "additionalProperties": false,
          "required": ["first_value", "codex_lifecycle", "migration", "managed_lifecycle"],
          "properties": {
            "first_value": {"$ref": "#/$defs/commandList"},
            "codex_lifecycle": {"$ref": "#/$defs/commandList"},
            "migration": {"$ref": "#/$defs/commandList"},
            "managed_lifecycle": {"$ref": "#/$defs/commandList"}
          }
        }
      }
    },
    "production_branch_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "feature_branches_require_review", "tags_are_not_automatic"],
      "properties": {
        "authority": {"const": "origin/Private-Beta"},
        "feature_branches_require_review": {"const": true},
        "tags_are_not_automatic": {"const": true}
      }
    },
    "public_commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "advanced_commands": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "research_surfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "production_ranking_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["interface", "provider_version", "request_schema", "result_schema", "compatibility_provider", "product_algorithm_agnostic", "public_experiment_identifiers", "fallback"],
      "properties": {
        "interface": {"const": "ProductionRankingProviderV1"},
        "provider_version": {"const": "production-ranking-provider.v1"},
        "request_schema": {"const": "schemas/production-ranking-request-v1.schema.json"},
        "result_schema": {"const": "schemas/production-ranking-provider-v1.schema.json"},
        "compatibility_provider": {"const": "IncumbentManifestRankingProviderV1"},
        "product_algorithm_agnostic": {"const": true},
        "public_experiment_identifiers": {"const": false},
        "fallback": {"type": "string", "minLength": 1}
      }
    },
    "canonical_packet_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "variant", "strategy", "public_renderer", "contract_schema", "model_facing_sections", "internal_anchors_model_facing"],
      "properties": {
        "version": {"const": "v5"},
        "variant": {"const": "tool_assisted_anchors_internal"},
        "strategy": {"const": "literal_symbol"},
        "public_renderer": {"const": "canonical_core_v1"},
        "contract_schema": {"const": "schemas/context-packet-v1.schema.json"},
        "model_facing_sections": {"type": "array", "items": {"enum": ["TASK", "LIKELY FILES", "PRIMARY", "VERIFY", "SUPPORT"]}, "uniqueItems": true},
        "internal_anchors_model_facing": {"const": false}
      }
    },
    "cross_process_contracts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "allOf": [
        {"contains": {"type": "object", "properties": {"name": {"const": "ContextRequestV1"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"name": {"const": "ContextSelectionV1"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"name": {"const": "ContextPacketV1"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"name": {"const": "ContextReceiptV1"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"name": {"const": "PacketStrategyPluginV1"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"name": {"const": "AgentAdapterV1"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "python_authority", "schema", "golden", "sensitivity", "unknown_versions"],
        "properties": {
          "name": {"enum": ["ContextRequestV1", "ContextSelectionV1", "ContextPacketV1", "ContextReceiptV1", "PacketStrategyPluginV1", "AgentAdapterV1"]},
          "python_authority": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "pattern": "^schemas/.+\\.json$"},
          "golden": {"type": "string", "pattern": "^contracts/goldens/.+\\.json$"},
          "sensitivity": {"enum": ["sensitive_private", "private_metadata", "content_free", "public_safe"]},
          "unknown_versions": {"const": "fail_closed"}
        }
      }
    },
    "install_state_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "schema", "default_receipt", "scope", "source_install_provenance", "authority_relationship", "preview_is_read_only", "unknown_schemas_fail_closed", "raw_prompts_or_packets_stored"],
      "properties": {
        "schema_version": {"const": "pcodex.install-state.v1"},
        "schema": {"const": "schemas/pcodex.install-state.schema.json"},
        "default_receipt": {"const": ".premode/install-state.json"},
        "scope": {"const": "per-file managed integration state"},
        "source_install_provenance": {"type": "string", "minLength": 1},
        "authority_relationship": {"type": "string", "minLength": 1},
        "preview_is_read_only": {"const": true},
        "unknown_schemas_fail_closed": {"const": true},
        "raw_prompts_or_packets_stored": {"const": false}
      }
    },
    "no_write_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "schema", "private_schema_version", "private_schema", "contract", "write_policy", "literal_operations", "apply_requires_explicit_authority", "missing_corrupt_or_future_state_is_not_repaired", "agent_launch_allowed", "temporary_packet_allowed", "raw_prompts_or_packets_stored"],
      "properties": {
        "schema_version": {"const": "pcodex.no-write-evidence.v1"},
        "schema": {"const": "schemas/pcodex.no-write-evidence.schema.json"},
        "private_schema_version": {"const": "pcodex.no-write-evidence.private.v1"},
        "private_schema": {"const": "schemas/pcodex.no-write-evidence.private.schema.json"},
        "contract": {"const": "docs/NO_WRITE_CONTRACT.md"},
        "write_policy": {"const": "advisory"},
        "literal_operations": {"type": "array", "items": {"enum": ["advisory", "preview", "dry-run"]}, "minItems": 3, "uniqueItems": true},
        "apply_requires_explicit_authority": {"const": true},
        "missing_corrupt_or_future_state_is_not_repaired": {"const": true},
        "agent_launch_allowed": {"const": false},
        "temporary_packet_allowed": {"const": false},
        "raw_prompts_or_packets_stored": {"const": false}
      }
    },
    "public_surface_inventory": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["surface", "classification", "kind"],
        "properties": {
          "surface": {"type": "string", "minLength": 1},
          "classification": {"enum": ["public_core", "public_codex", "advanced", "experimental", "research", "deprecated", "historical", "internal"]},
          "kind": {"type": "string", "minLength": 1}
        }
      }
    },
    "stateful_surface_inventory": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["surface", "location", "classification", "owner", "creation_trigger", "read_behavior", "write_behavior", "sensitivity", "schema_version", "cleanup_policy", "repair_policy", "uninstall_policy", "conflict_policy", "user_modification_policy"],
        "properties": {
          "surface": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "classification": {"enum": ["public_core", "public_codex", "advanced", "experimental", "research", "deprecated", "historical", "internal"]},
          "owner": {"type": "string", "minLength": 1},
          "creation_trigger": {"type": "string", "minLength": 1},
          "read_behavior": {"type": "string", "minLength": 1},
          "write_behavior": {"type": "string", "minLength": 1},
          "sensitivity": {"type": "string", "minLength": 1},
          "schema_version": {"type": "string", "minLength": 1},
          "cleanup_policy": {"type": "string", "minLength": 1},
          "repair_policy": {"type": "string", "minLength": 1},
          "uninstall_policy": {"type": "string", "minLength": 1},
          "conflict_policy": {"type": "string", "minLength": 1},
          "user_modification_policy": {"type": "string", "minLength": 1}
        }
      }
    },
    "integration_status": {
      "type": "object", "additionalProperties": false,
      "required": ["codex_cli", "codex_repo_assets", "mcp", "openclaw"],
      "properties": {
        "codex_cli": {"const": "supported_terminal_workflow"},
        "codex_repo_assets": {"const": "canonical_receipt_bound_opt_in_with_native_registration"},
        "mcp": {"const": "optional_workspace_bound_descriptor_and_registration_not_automatic"},
        "openclaw": {"const": "advanced_experimental_not_production_supported"}
      }
    },
    "known_beta_debt": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "commandList": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
