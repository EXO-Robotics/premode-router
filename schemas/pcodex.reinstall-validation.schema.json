{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pcodex.reinstall-validation.schema.json",
  "title": "pCodex private reinstall validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "operation_id", "operation_type", "started_at", "completed_at", "managed_root_hash", "ownership_id", "install_state_receipt", "operation_receipt", "authority_receipt_hash", "planned_actions", "completed_actions", "preserved_items", "conflicts", "manual_actions", "result", "failure_stage", "rollback_or_recovery_status"],
  "properties": {
    "schema_version": {"const": "pcodex.reinstall-validation.v1"},
    "product_version": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "operation_type": {"const": "reinstall_validation"},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "managed_root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ownership_id": {"type": "string", "minLength": 1},
    "install_state_receipt": {"type": "string", "minLength": 1},
    "operation_receipt": {"type": "string", "minLength": 1},
    "authority_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planned_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "completed_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "preserved_items": {"type": "array"},
    "conflicts": {"type": "array"},
    "manual_actions": {"type": "array"},
    "result": {"const": "validated"},
    "failure_stage": {"type": "null"},
    "rollback_or_recovery_status": {"type": "string", "minLength": 1}
  }
}
