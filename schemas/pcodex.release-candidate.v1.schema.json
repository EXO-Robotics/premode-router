{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/premode/schemas/pcodex.release-candidate.v1.schema.json",
  "title": "pCodex non-published release-candidate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "product_version", "candidate_commit",
    "supported_matrix", "canonical_source_cell", "release_subjects",
    "reproducibility_receipt_sha256", "provenance_authentication",
    "public_registry_published", "release_authorized"
  ],
  "properties": {
    "schema_version": {"const": "pcodex.release-candidate.v1"},
    "status": {"const": "qualified_not_published"},
    "product_version": {"const": "0.3.0b1"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "supported_matrix": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "python", "qualification_sha256"],
        "properties": {
          "system": {"enum": ["Darwin", "Linux"]},
          "python": {"enum": ["3.11", "3.12", "3.13"]},
          "qualification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "canonical_source_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "python"],
      "properties": {
        "system": {"const": "Linux"},
        "python": {"const": "3.11"}
      }
    },
    "release_subjects": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "reproducibility_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance_authentication": {"const": "unsigned_commit_and_sha256_bound"},
    "public_registry_published": {"const": false},
    "release_authorized": {"const": false}
  }
}
