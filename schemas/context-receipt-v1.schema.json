{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-receipt-v1.schema.json",
  "title": "ContextReceiptV1",
  "$comment": "Private repository-derived metadata. It contains no raw task or packet text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_boundary_mode",
    "packet_mode",
    "packet_detail_mode",
    "packet_detail_mode_requested",
    "packet_detail_mode_selected",
    "profile",
    "repo_map_enabled",
    "packet_total_tokens",
    "model_facing_packet_tokens",
    "hard_packet_token_budget",
    "selected_context_tokens",
    "saved_context_tokens",
    "model_facing_context_tokens",
    "model_facing_evidence_tokens",
    "local_manifest_tokens",
    "paths_only_packet_tokens",
    "evidence_snippet_packet_tokens",
    "full_repo_reduction_percent",
    "policy_metadata_tokens",
    "output_contract_tokens",
    "budget_exceeded",
    "budget_exceeded_by",
    "over_budget_reason",
    "full_text_file_count",
    "summary_file_count",
    "manifest_file_count",
    "schema_version",
    "sensitivity_classification"
  ],
  "properties": {
    "context_boundary_mode": {"type": "string"},
    "packet_mode": {"type": ["string", "null"]},
    "packet_detail_mode": {"type": ["string", "null"]},
    "packet_detail_mode_requested": {"type": ["string", "null"]},
    "packet_detail_mode_selected": {"type": ["string", "null"]},
    "profile": {"type": ["string", "null"]},
    "repo_map_enabled": {"type": "boolean"},
    "packet_total_tokens": {"type": ["number", "null"]},
    "model_facing_packet_tokens": {"type": ["number", "null"]},
    "hard_packet_token_budget": {"type": ["number", "null"]},
    "selected_context_tokens": {"type": ["number", "null"]},
    "saved_context_tokens": {"type": ["number", "null"]},
    "model_facing_context_tokens": {"type": ["number", "null"]},
    "model_facing_evidence_tokens": {"type": ["number", "null"]},
    "local_manifest_tokens": {"type": ["number", "null"]},
    "paths_only_packet_tokens": {"type": ["number", "null"]},
    "evidence_snippet_packet_tokens": {"type": ["number", "null"]},
    "full_repo_reduction_percent": {"type": ["number", "null"]},
    "policy_metadata_tokens": {"type": ["number", "null"]},
    "output_contract_tokens": {"type": ["number", "null"]},
    "budget_exceeded": {"type": "boolean"},
    "budget_exceeded_by": {"type": ["number", "null"]},
    "over_budget_reason": {"type": ["string", "null"]},
    "full_text_file_count": {"type": ["number", "null"]},
    "summary_file_count": {"type": ["number", "null"]},
    "manifest_file_count": {"type": ["number", "null"]},
    "schema_version": {"const": "pcodex.context-receipt.v1"},
    "sensitivity_classification": {"const": "private_metadata"}
  }
}
