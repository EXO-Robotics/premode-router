{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/premode_hook.py --mode strict",
            "statusMessage": "Checking Pre-mode compiled prompt"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/premode_hook.py --mode augment",
            "statusMessage": "Adding Pre-mode subagent context"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/premode_hook.py --mode augment",
            "statusMessage": "Recording Pre-mode subagent stop"
          }
        ]
      }
    ]
  }
}
