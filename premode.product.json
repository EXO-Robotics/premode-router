{
  "$schema": "./schemas/premode.product.schema.json",
  "schema_version": "premode.product.v2",
  "product_name": "pCodex",
  "release_target": "0.3.0b1",
  "release_class": "Codex-first private technical beta",
  "status": "source-visible proprietary private beta; not production-ready",
  "supported_runtime": "Codex CLI terminal workflow",
  "version_source": "src/premode/__init__.py::__version__ (pyproject and plugin versions derive from it)",
  "production_package": "premode-router",
  "phase_boundary": {
    "phase_a": "Codex-first 0.3.0b1 beta readiness",
    "phase_b": "Post-beta completion to the full 90/100 roadmap",
    "roadmap_authority": "docs/PRODUCT_ROADMAP.md",
    "phase_b_remains_required": true
  },
  "production_branch_policy": {
    "authority": "origin/Private-Beta",
    "feature_branches_require_review": true,
    "tags_are_not_automatic": true
  },
  "public_commands": [
    "pcodex install",
    "pcodex setup",
    "pcodex status",
    "pcodex run",
    "pcodex doctor",
    "pcodex review",
    "pcodex off",
    "pcodex cleanup",
    "pcodex repair",
    "pcodex uninstall",
    "premode review-patch"
  ],
  "advanced_commands": [
    "pcodex first-run",
    "pcodex on",
    "pcodex tuned",
    "pcodex tune",
    "pcodex ui",
    "pcodex compile",
    "pcodex mcp-server",
    "pcodex integrate codex",
    "pcodex plugin init",
    "premode compile",
    "premode benchmark",
    "premode stress"
  ],
  "research_surfaces": [
    "premode lab",
    "premode hook",
    "OpenClaw templates, fixtures, and execution-integration research",
    "observer and live-token harnesses"
  ],
  "production_ranking_authority": {
    "interface": "ProductionRankingProviderV1",
    "provider_version": "production-ranking-provider.v1",
    "request_schema": "schemas/production-ranking-request-v1.schema.json",
    "result_schema": "schemas/production-ranking-provider-v1.schema.json",
    "compatibility_provider": "IncumbentManifestRankingProviderV1",
    "product_algorithm_agnostic": true,
    "public_experiment_identifiers": false,
    "fallback": "explicit fallback or first-class abstention"
  },
