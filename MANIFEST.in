include README.md
include CHANGELOG.md
include pyproject.toml
include premode.product.json
recursive-include schemas *.json
include release/algorithm-handoff.v1.json
include contracts/goldens/agent-adapter-v1.json
include contracts/goldens/context-packet-v1.json
include contracts/goldens/context-receipt-v1.json
include contracts/goldens/packet-strategy-plugin-v1.json
include contracts/goldens/production-ranking-request-v1.json
include contracts/goldens/production-ranking-result-v1.json
recursive-include plugins/pcodex *
include plugins/pcodex/.codex-plugin/plugin.json
recursive-include src *.py
recursive-exclude src/premode lab73*.py
exclude src/premode/live_token_harness.py
exclude src/premode/sharded_runner.py
recursive-include docs *.md *.json
recursive-include examples *
prune tests
prune scripts
recursive-exclude .git *
recursive-exclude .venv *
recursive-exclude **/__pycache__ *
recursive-exclude .pytest_cache *
recursive-exclude .premode/out *
recursive-exclude .premode/audit *
recursive-exclude .premode/metrics *
recursive-exclude .premode/index *
recursive-exclude .pcodex *
global-exclude usage_ledger.jsonl
global-exclude .env
global-exclude .env.*
global-exclude *.pem
global-exclude *.key
global-exclude *credentials*
global-exclude *secret*
global-exclude *token*
global-exclude .DS_Store
global-exclude *.pyc
global-exclude *.pyo
