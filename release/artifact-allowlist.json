{
  "schema_version": "pcodex.artifact_allowlist.v1",
  "archive_limits": {
    "max_entries": 10000,
    "max_member_uncompressed_bytes": 33554432,
    "max_total_uncompressed_bytes": 268435456,
    "max_compression_ratio": 200.0
  },
  "wheel_allowed_prefixes": ["premode/", "premode_router-"],
  "wheel_allowed_members": [
    "premode/__init__.py",
    "premode/__main__.py",
    "premode/adapters.py",
    "premode/audit.py",
    "premode/backbone.py",
    "premode/benchmark.py",
    "premode/cache_manifest.py",
    "premode/candidate_policy.py",
    "premode/cli.py",
